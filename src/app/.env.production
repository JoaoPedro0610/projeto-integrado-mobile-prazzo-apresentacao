# Ambiente de PRODUCAO - carregado nos builds de release
# (`scripts/build-release.ps1` e `expo export`, que rodam com NODE_ENV=production).
# Pode ir para o Git: e so a URL publica da API, nao ha segredo aqui.
# Segredos (JWT_SECRET, DATABASE_URL) ficam so no painel do servidor da API.
#
# CONFIRMAR: troque pela URL real que o Render mostrar depois do deploy.
# A mesma URL esta no perfil "production" do eas.json - mantenha as duas iguais.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=https://prazzo-api.onrender.com
